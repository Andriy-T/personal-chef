# .env.example — Copy this to .env for local development
# Never commit your actual .env file.

# Server-owned key for the public text demo. Never expose it in the browser.
OPENROUTER_API_KEY=or-your-openrouter-api-key-here
OPENROUTER_DEMO_MODEL=openrouter/free

# OpenAI is now opt-in using the visitor's own key in the UI (including voice).
# An existing OPENAI_API_KEY in your local .env is not used for public access.
